# ─────────────────────────────────────────────────────────────
# Cited — environment template
# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug

# ── Shopify app ──────────────────────────────────────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://localhost:3000
SHOPIFY_APP_HANDLE=cited

# Base scopes — granted on install, no approval needed.
SHOPIFY_SCOPES=read_products,read_orders,read_customers,read_metaobjects

# Restricted scope for the standard `product_review` metaobject.
# ONLY granted after Shopify approves the app as a product review app
# (Partner Dashboard → Partners Internal → API Access). See PLAN.md §5.2.1.
# Once approved, append this to SHOPIFY_SCOPES and re-request grants.
SHOPIFY_SCOPES_RESTRICTED=write_product_reviews

# Invoice name of the free plan as defined in the Shopify dashboard.
SHOPIFY_FREE_PLAN_NAME=Free

# ── Datastores ───────────────────────────────────────────────
DATABASE_URL=postgresql://cited:cited@localhost:5433/cited?schema=public
REDIS_URL=redis://localhost:6380

# ── Crypto ───────────────────────────────────────────────────
# 64 hex chars (32 bytes). Doubles as the AES-256-GCM key for
# access tokens at rest — see lib/crypto.ts. Rotating this
# invalidates every stored Shopify access token.
SESSION_SECRET=

# ── Media storage: Cloudflare R2 ─────────────────────────────
# R2 chosen for ZERO egress fees — review photos/video are served
# millions of times. See PLAN.md §5.1.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cited-media
R2_PUBLIC_BASE_URL=

# Per-store media quota on the free plan (bytes). Cost control.
FREE_PLAN_MEDIA_QUOTA_BYTES=2147483648

# ── Email: AWS SES (bulk review requests) ────────────────────
# SES at ~$0.10/1000 is the only model that survives review-request
# volume. Resend/SMTP is the transactional fallback only.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=cited-reviews

RESEND_API_KEY=
FROM_EMAIL=no-reply@cited.reviews
SUPPORT_EMAIL=support@cited.reviews
COMPANY_ADDRESS=Cited · Bangalore, India

# Send-safety gate: any campaign above this recipient count requires
# explicit merchant confirmation before dispatch. Directly addresses
# the competitor failure mode in PLAN.md §2 (W4) — 3,620 emails sent
# on a default template without approval.
SEND_SAFETY_GATE_THRESHOLD=250
# Global per-store outbound cap per hour. Protects IP reputation.
EMAIL_RATE_PER_STORE_PER_HOUR=500

# ── AI (Anthropic) ───────────────────────────────────────────
ANTHROPIC_API_KEY=
# Haiku for high-volume classification/moderation; Sonnet for
# summaries and insight generation. Tier by job to control cost.
AI_MODEL_BULK=claude-haiku-4-5-20251001
AI_MODEL_REASONING=claude-sonnet-5
# Hard monthly spend ceiling per store (USD cents). Free tier = 0.
AI_BUDGET_CENTS_PER_STORE=500

# ── Observability ────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Ops / admin ──────────────────────────────────────────────
ADMIN_EMAILS=
ADMIN_BEARER=
CRON_SECRET=
PRIVACY_CONTACT_EMAIL=privacy@cited.reviews
DPA_URL=

# ── Rate limits ──────────────────────────────────────────────
RATE_LIMIT_MERCHANT_PER_MIN=100
RATE_LIMIT_PUBLIC_PER_MIN=30

# ── GDPR ─────────────────────────────────────────────────────
# When true, the storefront analytics pixel is fully disabled.
# Merchant-toggleable per store — competitor W5 is that theirs
# cannot be turned off without uninstalling. This is a selling point.
ANALYTICS_PIXEL_DEFAULT_ENABLED=true
