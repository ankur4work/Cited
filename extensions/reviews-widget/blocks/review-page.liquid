{% comment %}
  Cited — every review, as a page.

  Placed on a normal page ("All reviews", linked from a footer). Shows the
  store rating and the reviews in a responsive grid rather than a carousel,
  because this page is for browsing rather than glancing.

  Reads the same shop digest the carousel does, so it costs no request. That
  caps it at the digest size — a full archive with paging would need a request
  to our server on every view, which is exactly what this app is built not to
  do.
{% endcomment %}

{%- render 'cited-digest' -%}

{{ 'cited-reviews.css' | asset_url | stylesheet_tag }}

<section class="cited-page" style="{{ cited_style }}" {{ block.shopify_attributes }}>
  {%- if block.settings.heading != blank -%}
    <h2 class="cited-page__heading">{{ block.settings.heading | escape }}</h2>
  {%- endif -%}

  {%- if cited_count > 0 -%}
    <div class="cited-page__summary">
      <span class="cited-page__score">{{ cited_rating }}</span>
      {%- render 'cited-stars', rating: cited_rating, scale_max: 5, size: 18 -%}
      <span class="cited-page__count">
        {{ cited_count }} review{% unless cited_count == 1 %}s{% endunless %} across the store
      </span>
    </div>
  {%- endif -%}

  {%- if cited_reviews != blank and cited_reviews.size > 0 -%}
    <ul class="cited-page__grid" role="list">
      {%- for r in cited_reviews -%}
        <li>
          {%- render 'cited-quote-card', r: r, scale_max: 5, anon: cited_anon, show_product: true -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- else -%}
    <p class="cited-page__empty">{{ block.settings.empty_text | escape }}</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Cited Review Page",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer reviews"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Shown when there are no reviews yet",
      "default": "No reviews yet."
    },
    {
      "type": "paragraph",
      "content": "Colours are set in the Cited app under Widgets → Customize."
    }
  ]
}
{% endschema %}
