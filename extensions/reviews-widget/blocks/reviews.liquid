{% comment %}
  Cited — server-rendered product reviews, as an APP BLOCK.

  This is the precise-placement path: the merchant drops it inside their
  product section, exactly where reviews should sit, and no JavaScript is
  involved at any point — not to fetch the reviews, not to position them.

  It is not the only path. blocks/reviews-embed.liquid is a one-toggle
  alternative that works on every product without a placement step, for
  merchants whose theme refuses app blocks or who simply do not want to open
  the theme editor. Both render snippets/cited-reviews-body.liquid, and the
  script that positions the embed removes it when this block is present, so
  turning both on does not produce two sets of reviews.

  The architectural claim lives in the snippet: review text is inside
  Shopify's own HTML response, where crawlers and AI ingestion pipelines can
  read it. Every competitor injects it with JavaScript.
{% endcomment %}

{%- render 'cited-reviews-body',
  product: product,
  uid: block.id,
  shopify_attributes: block.shopify_attributes,
  is_embed: false,
  heading: block.settings.heading,
  per_page: block.settings.reviews_per_page,
  show_media: block.settings.show_media,
  enable_jsonld: block.settings.enable_jsonld,
  empty_text: block.settings.empty_text,
  anonymous_label: block.settings.anonymous_label,
  load_more_text: block.settings.load_more_text,
  enable_form: block.settings.enable_form,
  form_heading: block.settings.form_heading,
  form_button: block.settings.form_button,
  star_color: block.settings.star_color,
  text_color: block.settings.text_color,
  muted_color: block.settings.muted_color,
  border_color: block.settings.border_color,
  corner_radius: block.settings.corner_radius,
  spacing: block.settings.spacing
-%}

{% schema %}
{
  "name": "Cited Reviews",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer reviews"
    },
    {
      "type": "range",
      "id": "reviews_per_page",
      "label": "Reviews shown initially",
      "info": "Rendered server-side for SEO and AI crawlers. Higher values mean a larger HTML response.",
      "min": 3,
      "max": 25,
      "step": 1,
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "show_media",
      "label": "Show review photos",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_jsonld",
      "label": "Output structured data (JSON-LD)",
      "info": "Enables star ratings in Google results and makes reviews readable by AI shopping assistants. Turn off only if another app already outputs review structured data.",
      "default": true
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Text shown when there are no reviews",
      "default": "No reviews yet. Be the first to share your thoughts."
    },
    {
      "type": "text",
      "id": "anonymous_label",
      "label": "Label for anonymous reviewers",
      "default": "Anonymous"
    },
    {
      "type": "text",
      "id": "load_more_text",
      "label": "Load more button text",
      "default": "Show more reviews"
    },
    {
      "type": "header",
      "content": "Collecting reviews"
    },
    {
      "type": "checkbox",
      "id": "enable_form",
      "label": "Let shoppers write a review here",
      "info": "Shows a review form under the reviews. Submissions follow your moderation setting in the Cited admin.",
      "default": true
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Review form heading",
      "default": "Write a review"
    },
    {
      "type": "text",
      "id": "form_button",
      "label": "Submit button text",
      "default": "Submit review"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star colour",
      "default": "#FFB800"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Secondary text colour",
      "default": "#6B7280"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border colour",
      "default": "#E5E7EB"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Spacing",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ]
}
{% endschema %}
