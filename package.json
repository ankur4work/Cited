{
  "name": "cited",
  "version": "0.1.0",
  "private": true,
  "description": "Cited — Product Reviews & AI Visibility for Shopify",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "next dev --experimental-https --experimental-https-cert .shopify/localhost.pem --experimental-https-key .shopify/localhost-key.pem -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "worker": "tsx --env-file=.env jobs/worker.ts",
    "codegen": "graphql-codegen --config codegen.ts",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "secrets:scan": "gitleaks detect --config .gitleaks.toml --no-git --redact",
    "prepare": "husky install || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@aws-sdk/client-s3": "^3.687.0",
    "@aws-sdk/client-ses": "^3.687.0",
    "@aws-sdk/s3-request-presigner": "^3.687.0",
    "@prisma/client": "^5.20.0",
    "@react-email/components": "^0.0.25",
    "@react-email/render": "^1.0.1",
    "@sentry/nextjs": "^8.34.0",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/polaris": "^12.27.0",
    "@shopify/polaris-icons": "^9.3.0",
    "@shopify/shopify-api": "^11.4.1",
    "@tanstack/react-query": "^5.59.0",
    "@trpc/client": "^11.0.0-rc.553",
    "@trpc/next": "^11.0.0-rc.553",
    "@trpc/react-query": "^11.0.0-rc.553",
    "@trpc/server": "^11.0.0-rc.553",
    "bullmq": "^5.21.0",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.3",
    "next": "14.2.15",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "prom-client": "^15.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "resend": "^4.0.0",
    "sharp": "^0.33.5",
    "superjson": "^2.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.3",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "husky": "^9.1.6",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
